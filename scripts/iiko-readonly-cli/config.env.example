# Existing retro-protagonist / iikoWeb connection (recommended here)
IIKO_MODE=web
IIKO_SERVER_URL=
IIKO_STORE_ID=
IIKO_LOGIN=
IIKO_PASSWORD=
# Instead of login/password, an existing session may be supplied locally:
IIKO_COOKIE=

# Optional iikoCloud access for nomenclature/yandex-menu commands
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=
IIKO_API_BASE_URL=https://api-ru.iiko.services/api/1

IIKO_TIMEOUT=30
IIKO_GROUPED_RETRY_COUNT=15
IIKO_GROUPED_RETRY_DELAY_MS=1000
