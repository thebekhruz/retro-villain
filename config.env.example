IIKO_SERVER_URL=https://retro3158.iikoweb.ru
IIKO_LOGIN=
IIKO_PASSWORD=
IIKO_STORE_ID=
ACCOUNTANT_MANUAL_HANDOVER=1
# Рабочие SQLite находятся вне checkout; пустое значение использует ~/.local/share/retro-villain.
RETRO_DATA_DIR=
# Модуль директора: ключ остаётся только в build/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DIRECTOR_REPORT_RETENTION=24
IIKO_DIRECTOR_CATEGORIES=Основное меню=menu;Десерты=dessert;Напитки=drink
IIKO_DIRECTOR_EXCLUDED_GROUPS=Контейнеры;ДОСТАВКА ЯНДЕКС
# Для доступа с других устройств: настроить обе переменные, использовать HTTPS.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Ролевой доступ: по одной записи cashier/accountant/director/founder;
# необязательно добавьте admin с доступом ко всем панелям.
# Формат: user:password:role;user:password:role. Не коммитьте заполненное значение.
DASHBOARD_PANEL_USERS=
# При локальном доступе можно ограничить клиентов своей подсетью (CIDR).
DASHBOARD_ALLOWED_NETWORK=
# Только CIDR адресов reverse proxy; вне него X-Forwarded-For игнорируется.
TRUSTED_PROXY_NETWORK=
# Агрегированная аналитика Telegram-бота бронирований. Токен остаётся на сервере.
BOOKING_ANALYTICS_URL=https://booking-api.example.com
ANALYTICS_API_TOKEN=
